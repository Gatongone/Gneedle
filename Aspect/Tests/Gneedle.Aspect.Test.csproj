<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The framework which MSBuild runs a task in on Windows, which is the one the task is loaded by here. The
             assemblies of MSBuild are given to it by the build, and this project takes them for itself below. -->
        <TargetFrameworks>net472</TargetFrameworks>
        <OutputType>Library</OutputType>
        <LangVersion>12</LangVersion>
        <RootNamespace>Gneedle.Aspect.Test</RootNamespace>

        <!-- The scan of the solution adds the injection target to every project which references this one, and this
             project calls the task itself rather than being injected into. It is also the toggle which the tests
             exercise. -->
        <Aspect>disable</Aspect>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tests construct the task and run it themselves, where the build which runs it for real provides these
             to it. The project under test keeps them private, as a task should. -->
        <PackageReference Include="Microsoft.Build" Version="17.6.3" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.6.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nuget\Gneedle.Aspect.csproj" />
        <ProjectReference Include="..\..\Inject\Source\Gneedle.Inject.csproj" />
    </ItemGroup>

</Project>
