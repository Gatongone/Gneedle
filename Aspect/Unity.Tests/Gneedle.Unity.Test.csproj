<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The editor of Unity runs the post processor on the framework of the editor, which is the one it is tested
             on here. -->
        <TargetFrameworks>net472</TargetFrameworks>
        <OutputType>Library</OutputType>
        <LangVersion>12</LangVersion>
        <RootNamespace>Gneedle.Unity.Test</RootNamespace>

        <!-- The name of the assembly which Unity compiles the sources of the package into, which is what the internals
             of the weaver are handed to: the sources of the package are compiled into this assembly here, so that what
             is tested is what the editor runs. -->
        <AssemblyName>Unity.Gneedle.CodeGen</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Inject\Source\Gneedle.Inject.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The post processor which the editor compiles out of the package is compiled here beside the tests, and the
             types of Unity which it is written against are the stubs which this project carries: the tests are run
             where no editor is installed. -->
        <Compile Include="..\Unity\Editor\GneedleILPostProcessor.cs" Link="GneedleILPostProcessor.cs" />
    </ItemGroup>

</Project>
