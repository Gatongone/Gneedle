<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>$id$</id>
        <version>$version$</version>
        <title>$id$</title>
        <authors>Gatongone</authors>
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <license type="file">docs\LICENSE.txt</license>
        <readme>docs\README.md</readme>
        <repository type="git" url="https://github.com/Gatongone/Gneedle"/>
        <description>Gneedle weaver analyzer.</description>
        <copyright>© 2024 Gatongone</copyright>
        <tags>ILWeaving, AOP</tags>

        <!-- The task weaves through the weaver and is compiled against it, so the assembly is needed beside it at run
             time. It is named here rather than taken from the reference, because the file which describes the package
             describes what it carries, and the two packages are published together at one version. -->
        <dependencies>
            <group targetFramework="net472">
                <dependency id="Gneedle.Inject" version="$version$"/>
            </group>
            <group targetFramework="netstandard2.1">
                <dependency id="Gneedle.Inject" version="$version$"/>
            </group>
            <group targetFramework="net5.0">
                <dependency id="Gneedle.Inject" version="$version$"/>
            </group>
        </dependencies>
    </metadata>

    <files>
        <file src="$id$.props" target="build"/>
        <file src="$id$.targets" target="build"/>

        <!-- The task is loaded by the build from the folder which holds it, and it resolves the assemblies it is
             compiled against from that same folder, so they are packed beside it under tools: what lib holds is offered
             to the project which installs the package as a reference, and the task is not a reference of that project.
             The framework is the one the build which loads it runs on, which is the one the props picks between. -->
        <file src=".\bin\$configuration$\net472\$id$.dll" target="tools\net472"/>
        <file src=".\bin\$configuration$\net472\$id$.pdb" target="tools\net472"/>
        <file src=".\bin\$configuration$\net472\Gneedle.Inject.dll" target="tools\net472"/>
        <file src=".\bin\$configuration$\net472\Gneedle.Inject.pdb" target="tools\net472"/>
        <file src=".\bin\$configuration$\net472\Mono.Cecil*.dll" target="tools\net472"/>

        <file src=".\bin\$configuration$\netstandard2.1\$id$.dll" target="tools\netstandard2.1"/>
        <file src=".\bin\$configuration$\netstandard2.1\$id$.pdb" target="tools\netstandard2.1"/>
        <file src=".\bin\$configuration$\netstandard2.1\Gneedle.Inject.dll" target="tools\netstandard2.1"/>
        <file src=".\bin\$configuration$\netstandard2.1\Gneedle.Inject.pdb" target="tools\netstandard2.1"/>
        <file src=".\bin\$configuration$\netstandard2.1\Mono.Cecil*.dll" target="tools\netstandard2.1"/>

        <file src="..\..\LICENSE.txt" target="docs"/>
        <file src="..\..\README.md" target="docs"/>
    </files>
</package>