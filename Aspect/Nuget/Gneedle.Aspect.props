<Project>
   <PropertyGroup>
      <AspectId>Gneedle.Aspect</AspectId>
      <AspectProjPath>..</AspectProjPath>
      <!-- A full framework MSBuild cannot load the netstandard2.1 build, so the runtime of MSBuild tells which one to
           load. The two conditions used to be the wrong way round, which made a dotnet build load the net472 one.
           The task is held under tools, which is the folder of the package which the build loads it from. -->
      <AspectOutPath Condition="$(MSBuildRuntimeType) == 'Core'">$(AspectProjPath)\tools\netstandard2.1</AspectOutPath>
      <AspectOutPath Condition="$(MSBuildRuntimeType) != 'Core'">$(AspectProjPath)\tools\net472</AspectOutPath>

      <!-- Keep the attributes which the injectors are read from, and the reference to the weaver which they name, in
           the assembly which is woven. They are removed by default, so that the assembly does not carry the weaver. A
           project which declares its attributes for another project to weave with is the one which wants this.
           The other property of the pair is written in the project itself: <Gneedle>disable</Gneedle> tells the scan of
           the solution to leave the project alone, and the task to weave nothing into it. -->
      <GneedleKeepWeaver Condition="'$(GneedleKeepWeaver)' == ''">false</GneedleKeepWeaver>
   </PropertyGroup>
</Project>
