<Project>
   <PropertyGroup>
      <AspectId>Gneedle.Aspect</AspectId>
      <AspectProjPath>..</AspectProjPath>
      <!-- A full framework MSBuild cannot load the netstandard2.1 build, which is what the runtime picks between; the
           two conditions were the wrong way round once, which made a dotnet build load the net472 one. -->
      <AspectOutPath Condition="$(MSBuildRuntimeType) == 'Core'">$(AspectProjPath)\tools\netstandard2.1</AspectOutPath>
      <AspectOutPath Condition="$(MSBuildRuntimeType) != 'Core'">$(AspectProjPath)\tools\net472</AspectOutPath>

      <!-- The properties which describe a project are read from the project itself, see the section of the readme which
           is named for them; this one is defaulted because the targets are read whatever the project says. -->
      <KeepWeaver Condition="'$(KeepWeaver)' == ''">false</KeepWeaver>
   </PropertyGroup>
</Project>