<Project Sdk="Microsoft.NET.Sdk">

    <!-- The metadata which both packages are published with, kept in one file because the two projects which are packed
         are the only ones which need it. -->
    <Import Project="..\..\Build\Package.props"/>

    <PropertyGroup>
        <RootNamespace>Gneedle.Aspect</RootNamespace>
        <TargetFrameworks>net5.0;netstandard2.1;net472</TargetFrameworks>

        <!-- A package is made by `dotnet pack`, which builds the frameworks which it packs. The property which makes a
             build pack as well is not set, because it works the other way round: a `dotnet pack` of a project which
             sets it packs what a build left behind rather than building that, and run where nothing was built it fails
             with "File not found" for the assembly of every framework which it was to pack. -->
        <Description>Gneedle.Aspect is the aspect weaver: an MSBuild task which applies the injectors of a project to the assembly which it builds, so that weaving needs no step of its own beyond the package. An injector is an attribute which implements one of the interfaces of Gneedle.Inject, for a method or a field or a property as well as for a type or for the assembly, and says what to do with the member it is put on. The template which an injector applies is usually a lambda which captures what the attribute was given, and what it captured is written into the assembly which is woven as the value itself. By the time the assembly is written the injectors have been applied and the attributes have done their work, so the task removes them with the types which declare them and drops the reference to the weaver, leaving nothing of the weaver in the assembly which was woven.</Description>
        <PackageTags>Aspect</PackageTags>
        <Title>Gneedle.Aspect</Title>

        <!-- The task is not a reference of the project which installs the package, it is what the build of that project
             loads and runs: nothing of it goes to lib, and what it loads is packed beside it under tools. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTools</TargetsForTfmSpecificContentInPackage>

        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- Two of the warnings of this project are the arrangement rather than a fault of it, and are turned off here for
         the reason each of them is raised with.

         NU1701: the packages this project is built on carry no assembly for the frameworks it is built for -
         Microsoft.Build and Microsoft.IO.Redist hold a net472 build and a net7.0 build alone - so a project of net5.0
         or of netstandard2.1 resolves them through the net472 one. That is what the task wants: what runs them is the
         build which loads the task, and the reference below excludes their runtime, so nothing of theirs is carried
         beside the task.

         NU5128: the pack of this project reports that the frameworks of its dependency groups have no assemblies to
         answer to, which is the same arrangement from the other side - a task which is loaded and run by a build is
         packed under tools and has nothing to put under lib. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);NU1701;NU5128</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <AspectOutPath Condition="$(MSBuildRuntimeType) == 'Core'">$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.1</AspectOutPath>
        <AspectOutPath Condition="$(MSBuildRuntimeType) != 'Core'">$(MSBuildThisFileDirectory)bin\$(Configuration)\net472</AspectOutPath>
        <AspectTargetPath>$(AspectOutPath)\Gneedle.Aspect.dll</AspectTargetPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="17.6.3" PrivateAssets="all" ExcludeAssets="runtime"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.6.3" PrivateAssets="all" ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Inject\Source\Gneedle.Inject.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- What a project which installs the package reads: the props which point the build at the task, and the target
             which runs it. -->
        <None Include="$(MSBuildProjectName).props" Pack="true" PackagePath="build\"/>
        <None Include="$(MSBuildProjectName).targets" Pack="true" PackagePath="build\"/>
    </ItemGroup>

    <!-- The task and the assemblies which it loads, packed for the two frameworks which the props picks between. -->
    <Target Name="PackTools">
        <ItemGroup Condition="'$(TargetFramework)' == 'net472' Or '$(TargetFramework)' == 'netstandard2.1'">
            <TfmSpecificPackageFile Include="$(TargetDir)$(MSBuildProjectName).dll" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)$(MSBuildProjectName).pdb" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)$(MSBuildProjectName).xml" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)Gneedle.Inject.dll" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)Gneedle.Inject.pdb" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)Gneedle.Inject.xml" PackagePath="tools\$(TargetFramework)\"/>
            <TfmSpecificPackageFile Include="$(TargetDir)Mono.Cecil*.dll" PackagePath="tools\$(TargetFramework)\"/>
        </ItemGroup>
    </Target>

    <!-- The name of a task is qualified by the namespace of its type, while the project name is the one which a
         reference to this project names. Nothing in this file declares $(ProjectName), so both were empty: the task was
         found by its own name alone, and it was given no name to look for, which made it clean rather than add. -->
    <PropertyGroup>
        <!-- Whether a build of this repository weaves the projects of its own solution, which is done by loading the
             task from the very folder which this project builds into. Such a build holds the assembly of the task open
             for as long as the node it was loaded into lives, and the nodes of MSBuild are reused across builds, so the
             next build of this project cannot write over the assembly it is replacing: it fails on its own output with
             MSB3021 and MSB3027, and a rebuild of the solution fails every time. The scan is therefore off unless it is
             asked for, and while it is off a build never loads the task and never holds its own output open.

             A solution which is built with it on pays for what it does: `-nodeReuse:false` on the build which runs the
             scan, or a `dotnet build-server shutdown` before the next one, because the node which loaded the task is
             the node which would otherwise be reused with the assembly still open. -->
        <GneedleSelfWeave Condition="'$(GneedleSelfWeave)' == ''">false</GneedleSelfWeave>
    </PropertyGroup>

    <UsingTask TaskName="$(RootNamespace).AddProjectsPostBuild" AssemblyFile="$(AspectTargetPath)" Condition="'$(GneedleSelfWeave)' == 'true'"/>
    <!-- The scan walks the solution which this project is built with, and a build of the project on its own has none:
         it leaves the solution properties at the literal `*Undefined*`, which is not a path, so the scan is skipped
         there rather than handed something the task cannot parse. -->
    <Target Name="SolutionScan" AfterTargets="PostBuildEvent" Condition="'$(GneedleSelfWeave)' == 'true' And Exists('$(SolutionPath)') And Exists('$(AspectTargetPath)')">
        <AddProjectsPostBuild ProjectName="$(MSBuildProjectName)" SolutionPath="$(SolutionPath)" TargetPath="$(AspectTargetPath)"/>
    </Target>
</Project>