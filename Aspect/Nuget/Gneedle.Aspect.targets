<Project>
    <UsingTask TaskName="$(AspectId).AssemblyInject" AssemblyFile="$(AspectOutPath)\$(AspectId).dll"/>
    <Target Name="GneedleTarget" AfterTargets="PostBuildEvent">
        <AssemblyInject ProjectPath="$(ProjectPath)" TargetPath="$(TargetPath)" KeepWeaver="$(GneedleKeepWeaver)"/>
    </Target>
</Project>