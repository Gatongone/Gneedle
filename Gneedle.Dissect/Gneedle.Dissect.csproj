<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Gneedle.Dissect</RootNamespace>
        <NuSpecFile>Gneedle.Dissect.nuspec</NuSpecFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <TargetFrameworks>netstandard2.1;net472;</TargetFrameworks>
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <DissectOutPath Condition="$(MSBuildRuntimeType) == 'Core'">$(MSBuildThisFileDirectory)bin\$(Configuration)\net472</DissectOutPath>
        <DissectOutPath Condition="$(MSBuildRuntimeType) == 'Core'">$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.1</DissectOutPath>
        <DissectTargetPath>$(DissectOutPath)\Gneedle.Dissect.dll</DissectTargetPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build" Version="17.6.3"/>
        <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.11.4"/>
    </ItemGroup>

    <Target Name="SetNuspecProperties" BeforeTargets="GenerateNuspec">
        <PropertyGroup>
            <NuspecProperties>id=$(MSBuildProjectName);authors=$(Authors);version=$(PackageVersion);configuration=$(Configuration);</NuspecProperties>
        </PropertyGroup>
    </Target>

    <UsingTask TaskName="$(ProjectName).AddProjectsPostBuild" AssemblyFile="$(DissectTargetPath)"/>
    <Target Name="SolutionScan" AfterTargets="PostBuildEvent" Condition="Exists('$(DissectTargetPath)')">
        <AddProjectsPostBuild ProjectName="$(ProjectName)" SolutionPath="$(SolutionPath)" TargetPath="$(DissectTargetPath)"/>
    </Target>

</Project>