<Project>

    <!-- The metadata which the packages of this repository are published with, written once for both of them and
         imported by each of the two projects which is packed: see the comment at the import of each of them.
         The two are released together at one version, because the aspect weaver depends on the weaver: that dependency
         carries the version of the reference which the project holds, which is the version written here. -->
    <PropertyGroup>
        <Version>0.0.2</Version>
        <AssemblyVersion>0.0.2</AssemblyVersion>
        <FileVersion>0.0.2</FileVersion>

        <Authors>Gatongone</Authors>
        <Copyright>© 2026 Gatongone</Copyright>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <PackageProjectUrl>https://github.com/Gatongone/Gneedle</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Gatongone/Gneedle.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <!-- A package carries the symbols of what it holds as well, so that a stack trace of the assembly which was
             packed names the members it ran. -->
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

        <!-- The comments which the sources carry are packed with the assembly they describe, so that a consumer reads
             the comment of a member where it writes the call rather than in the repository. The file is written by the
             compiler out of the sources, and a publicly visible member which carries no comment is reported by that
             same build, which is the check that the file is worth shipping at all. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- The license and the readme of a package are the ones of the repository. The two paths are the ones which the
             files take inside the package, which is what the format reads, rather than the ones they lie at on disk. -->
        <PackageLicenseFile>docs\LICENSE.txt</PackageLicenseFile>
        <PackageReadmeFile>docs\README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\LICENSE.txt" Pack="true" PackagePath="docs\"/>
        <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="docs\"/>
    </ItemGroup>

</Project>