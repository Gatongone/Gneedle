<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>$id$</id>
        <version>$version$</version>
        <title>$id$</title>
        <authors>Gatongone</authors>
        <requireLicenseAcceptance>true</requireLicenseAcceptance>
        <license type="file">docs\LICENSE.txt</license>
        <readme>docs\README.md</readme>
        <repository type="git" url="https://github.com/Gatongone/Gneedle"/>
        <description>Gneedle weaver.</description>
        <copyright>© 2024 Gatongone</copyright>
        <tags>ILWeaving, AOP</tags>

        <!-- The library weaves through Mono.Cecil and is compiled against it, so the assembly is needed beside it at
             run time whether or not a caller names a type of it. -->
        <dependencies>
            <group targetFramework="net472">
                <dependency id="Mono.Cecil" version="0.11.5"/>
            </group>
            <group targetFramework="netstandard2.1">
                <dependency id="Mono.Cecil" version="0.11.5"/>
            </group>
            <group targetFramework="net5.0">
                <dependency id="Mono.Cecil" version="0.11.5"/>
            </group>
        </dependencies>
    </metadata>

    <files>
        <file src=".\bin\$configuration$\net472\$id$.dll" target="lib\net472"/>
        <file src=".\bin\$configuration$\net472\$id$.pdb" target="lib\net472"/>

        <file src=".\bin\$configuration$\netstandard2.1\$id$.dll" target="lib\netstandard2.1"/>
        <file src=".\bin\$configuration$\netstandard2.1\$id$.pdb" target="lib\netstandard2.1"/>

        <file src=".\bin\$configuration$\net5.0\$id$.dll" target="lib\net5.0"/>
        <file src=".\bin\$configuration$\net5.0\$id$.pdb" target="lib\net5.0"/>

        <file src="..\..\LICENSE.txt" target="docs"/>
        <file src="..\..\README.md" target="docs"/>
    </files>
</package>
