<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net5.0;netstandard2.1;net472</TargetFrameworks>
        <OutputType>Library</OutputType>
        <LangVersion>12</LangVersion>
        <RootNamespace>Gneedle.Inject.Test</RootNamespace>

        <!-- The templates which the tests weave are the IL which the compiler wrote for them, and the tests read that
             IL back: a local variable of a template, the instructions which stand before it, and the shape of a body
             are all asserted on. A build which optimizes this assembly takes them out of it - a local which is only
             ever null and read once is not a local at all under optimization, so the template compiles to the value
             which was folded into the call - and the tests which read it fail for what the compiler did rather than
             for what the weaver did. The assembly which holds the templates is therefore never optimized, whichever
             configuration the tests are built in. -->
        <Optimize>false</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Source\Gneedle.Inject.csproj" />
    </ItemGroup>

</Project>