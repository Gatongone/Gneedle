<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- The frameworks which the tests are built for and run on. netstandard2.1 is not one of them: an assembly of
             tests is run rather than referred to, and there is no runtime which runs one built for a standard, so a test
             run which holds it fails whole - the two which pass are answered, and the command still reports failure.
             The library is built for netstandard2.1 whether or not this is, which is what a Unity project reaches the
             weaver through, and a build of it which does not compile is a build which fails. -->
        <TargetFrameworks>net5.0;net472</TargetFrameworks>
        <!-- Ignore .net5.0 EOL -->
        <CheckEolTargetFramework>false</CheckEolTargetFramework>

        <OutputType>Library</OutputType>
        <!-- The comments of the tree are written for every project of it, and the tests document nothing of their own:
             what a test asserts is its name and what it reports, and a comment beside it would be a second copy of
             that. The one report which is turned off here is the member which carries no comment. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <RootNamespace>Gneedle.Inject.Test</RootNamespace>

        <!-- The templates which the tests weave are the IL which the compiler wrote for them, and the tests read that
             IL back: a local variable of a template, the instructions which stand before it, and the shape of a body
             are all asserted on. The shapes which those assertions name are the ones which a build without the
             optimizer writes - a temporary which the optimizer folds into the use of it is no local of the body which
             stands before a call, and the read of it is not there to be counted - so this assembly is built without
             the optimizer by default, whichever configuration the tests are built in. What the optimizer writes is
             what the assembly of a consumer holds, which is a shape the suite covers as well: the same tests are run
             a second time against a build of this assembly which is optimized, which is what `-p:Optimize=true` asks
             for. The property is a global one, so it reaches the weaver through the reference below on its own, and it
             is taken out of that reference: the run which is about the shape of the templates varies that and nothing
             else. -->
        <Optimize>false</Optimize>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
        <PackageReference Include="NUnit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnit.Analyzers" Version="3.6.1" />
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(Optimize)' == 'true'">
        <!-- What asks for the leg above is a flag rather than a file, and a build is up to date against files: this names
             the leg in the assembly which is built, which is a source file of that build, so that a run of one leg is
             never answered by the build of the other. It is read back out of the metadata of the assembly by the tests,
             which is what tells a run of one leg from a run of the other. -->
        <AssemblyMetadata Include="OptimizedTemplates" Value="true" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Source\Gneedle.Inject.csproj" GlobalPropertiesToRemove="Optimize" />
    </ItemGroup>

</Project>