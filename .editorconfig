# The files of this repository are UTF-8 without a byte order mark. `utf-8` is that; `utf-8-bom` is the other.
# A text file of it lies with LF, which `.gitattributes` gives a checkout as well, so that an editor writes no other
# line ending back and leaves a working tree which differs from the repository in every line of every file.
root = true

[*]
charset = utf-8
end_of_line = lf
